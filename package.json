{
  "name": "reflection.dev",
  "version": "0.1.1",
  "description": "reflection.dev -- organization site and documentation hub",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-docs": "node scripts/fetch-docs.mjs",
    "dev": "pnpm sync-docs && eleventy --serve --port 8080",
    "build": "pnpm run clean && pnpm sync-docs && eleventy && pagefind --site _site",
    "clean": "rm -rf _site src/docs/nixops",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "^1.3.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
