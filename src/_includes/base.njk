<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafbfd" media="(prefers-color-scheme: light)" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    {% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.bunny.net/css?family=inter:400,500,600,700&display=swap"
    />
    <link rel="stylesheet" href="/assets/style.css" />
    <script>
      // No-flash theme setup: run before body paints.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
          var theme = saved || (prefersLight ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">
        <svg class="site-mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" fill="currentColor" opacity="0.15" />
          <path d="M7 7h6a4 4 0 010 8H7V7zm0 8v4M13 15l4 4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{{ site.name }}</span>
      </a>
      <nav class="site-nav">
        <button
          type="button"
          class="search-trigger"
          aria-label="Search (Ctrl+K)"
          data-search-trigger
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" />
            <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span class="search-trigger-label">Search</span>
          <kbd class="search-trigger-kbd">⌘K</kbd>
        </button>
        <a href="/docs/">Docs</a>
        <a href="{{ site.github }}" rel="noopener">GitHub</a>
        <button
          type="button"
          class="theme-toggle"
          aria-label="Toggle color theme"
          data-theme-toggle
        >
          <svg data-theme-icon-dark viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="currentColor" />
          </svg>
          <svg data-theme-icon-light viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" hidden>
            <circle cx="12" cy="12" r="4" fill="currentColor" />
            <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
          </svg>
        </button>
      </nav>
    </header>

    <main class="site-main{% if wide %} site-main--wide{% endif %}{% if home %} site-main--home{% endif %}">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>© {{ site.name }}</span>
      <span><a href="{{ site.github }}" rel="noopener">github.com/{{ site.org }}</a></span>
    </footer>

    <dialog class="search-modal" data-search-modal aria-label="Search">
      <form method="dialog" class="search-modal-form">
        <div class="search-modal-input-wrap">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" />
            <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            class="search-modal-input"
            placeholder="Search docs…"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          />
          <kbd class="search-modal-kbd">Esc</kbd>
        </div>
        <div class="search-modal-results" data-search-results>
          <div class="search-modal-hint">Start typing to search.</div>
        </div>
      </form>
    </dialog>

    <script src="/assets/theme.js" defer></script>
    <script src="/assets/code-enhance.js" defer></script>
    <script src="/assets/search.js" defer></script>
  </body>
</html>
